{
  "name": "weimar-digital",
  "version": "0.5.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "description": "The Weimar Republic — local rules-engine workbench",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "audit:cards": "node scripts/audit-card-scope.ts",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
